{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SARIF 2.1.0 minimal subset",
  "type": "object",
  "required": ["version", "runs"],
  "properties": {
    "version": {"const": "2.1.0"},
    "$schema": {"type": "string"},
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["tool", "results"],
        "properties": {
          "tool": {
            "type": "object",
            "required": ["driver"],
            "properties": {
              "driver": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": {"type": "string"},
                  "version": {"type": "string"},
                  "informationUri": {"type": "string"},
                  "rules": {"type": "array"}
                }
              }
            }
          },
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["ruleId", "message"],
              "properties": {
                "ruleId": {"type": "string"},
                "level": {"enum": ["none", "note", "warning", "error"]},
                "message": {
                  "type": "object",
                  "required": ["text"],
                  "properties": {"text": {"type": "string"}}
                },
                "locations": {"type": "array"}
              }
            }
          }
        }
      }
    }
  }
}
